{
  // Nama ini menentukan alamat gratis Anda:
  // https://rss-anywhere.<subdomain>.workers.dev
  // Ganti "rss-anywhere" kalau nama itu sudah dipakai akun lain.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rss-anywhere",
  "main": "src/worker.js",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "observability": {
    "enabled": true
  }
}
